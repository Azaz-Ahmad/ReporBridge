DATABASE_URL=postgresql+psycopg://reprobridge:replace-me@127.0.0.1:5432/reprobridge
POSTGRES_PASSWORD=replace-me
COORDINATOR_TOKEN=
REVIEWER_TOKEN=
VIEWER_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Required: exact model ID permitted by your provider/key; no model is chosen automatically.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2400
OPENAI_MAX_TOOL_CALLS=8
OPENAI_MAX_AGENT_STEPS=6
# Cost estimation unavailable. A configured dollar ceiling disables runs safely.
OPENAI_MAX_RUN_COST_USD=
CLINICAL_EVIDENCE_AGENT_ENABLED=false
# Multi-agent limits are separate; no automatic model escalation.
MULTI_AGENT_MAX_OUTPUT_TOKENS=4000
MULTI_AGENT_REASONING_EFFORT=low
# Optional single-agent provider override; unset preserves its existing behavior.
OPENAI_REASONING_EFFORT=
# Explicit execution profile; failures never switch profiles automatically.
MULTI_AGENT_EXECUTION_PROFILE=optimized
# Independent read-only specialist model calls may overlap on a sealed snapshot.
MULTI_AGENT_PARALLEL=true

# Enable only for synthetic demonstrations; per-browser session date override.
DEMO_MODE=false

# Explicit transport; replay never invokes a model or silently falls back to live.
LLM_MODE=live
# Default: backend/demo-replays. Install only real, sanitized recordings.
LLM_REPLAY_DIR=
# Set only while recording live synthetic scenarios.
LLM_RECORD_DIR=
