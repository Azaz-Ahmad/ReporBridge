DATABASE_URL=postgresql+psycopg://reprobridge:replace-me@127.0.0.1:5432/reprobridge
POSTGRES_PASSWORD=replace-me
COORDINATOR_TOKEN=
REVIEWER_TOKEN=
VIEWER_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-3.8-flash-20260902
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2400
OPENAI_MAX_TOOL_CALLS=8
OPENAI_MAX_AGENT_STEPS=6
# Cost estimation unavailable. A configured dollar ceiling disables runs safely.
OPENAI_MAX_RUN_COST_USD=
CLINICAL_EVIDENCE_AGENT_ENABLED=false
# Multi-agent limits are separate; no automatic model escalation.
MULTI_AGENT_MAX_OUTPUT_TOKENS=4000
MULTI_AGENT_REASONING_EFFORT=low
# Optional single-agent provider override; unset preserves its existing behavior.
OPENAI_REASONING_EFFORT=
